# Copy this file to ".env" and fill in your Firebase web app config.
# Find these values in Firebase Console > Project settings > Your apps > SDK setup.
# The app works without these (it falls back to localStorage), but Sync requires them.

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=area-book
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
